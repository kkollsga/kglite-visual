# Rust build artifacts
/target
/**/target/

# Frontend build + dependency artifacts. The embedded static bundle is
# generated by the frontend build and baked into the CLI binary by rust-embed;
# it is regenerable output, never source.
node_modules/
/frontend/dist/
/frontend/.vite/
*.tsbuildinfo

# Playwright: downloaded browsers live in the user's cache, but the runner
# writes screenshots, traces and reports into the tree on every run.
/frontend/tests/e2e/artifacts/
/frontend/test-results/
/frontend/playwright-report/

# Python / maturin build artifacts
__pycache__/
*.py[cod]
*.so
*.pyd
/build/
/dist/
/wheels/
*.egg-info/

# Python virtualenvs / test + lint caches
/.venv/
/.venv*/
/.pytest_cache/
/.ruff_cache/
/.mypy_cache/

# Graph files. `.kgl` inputs are other people's data or regenerable fixtures;
# heavy either way. Small committed fixtures get an explicit `!` here in the
# same change that adds them.
*.kgl
*.kgl.lock
# P2's meta-graph fixture: ~11 KB, regenerated by `make fixture` from a seeded
# graphgen run and verified byte-stable there. Tracked because the meta-graph
# tests, the positions baseline and the e2e counts all assert against these
# exact bytes.
!/crates/kglite-visual-core/tests/fixtures/*.kgl

# Codex conventions and skills are generated adapters of the tracked
# CLAUDE.md / .claude/skills/ authority (see the Authority line in CLAUDE.md).
# Regenerate them with `make sync-agents`; never hand-edit or stage them.
/.agents/
/AGENTS.md
# Claude Code machine-local state (settings.local.json, worktree bookkeeping).
# `.claude/skills/` is deliberately NOT ignored — see the note below.
/.claude/settings.local.json
/.claude/worktrees/

# Local dev working state — never committed. Canonical layout maps:
# dev-docs/README.md and inbox/README.md. Durable tiers: `plans/`, `designs/`,
# `bench/scripts/`, `bench/results/`, `todos.md`. Auto-purged by the
# dev-docs-cleanup skill: `temp/` (>1d — offload large output here instead of
# printing it), `bench/out/` (>14d, generated heavy artifacts), `bin/` (>7d,
# soft-deleted docs).
#
# ONE exception: `bench/scripts/` IS tracked. Harnesses there are hand-authored
# source that would otherwise exist in exactly one copy, in a tier nothing ever
# purges; a stray `rm -rf` loses work no backup, review or CI ever saw. The
# directory is empty today — un-ignoring it now means the first harness written
# here is tracked by default instead of silently unbacked. Build output and
# captures produced inside a harness dir stay ignored.
# (`/dir/*` + `!/dir/sub/` so a subdir can be re-included.)
/dev-docs/*
!/dev-docs/bench/
/dev-docs/bench/*
!/dev-docs/bench/scripts/
/dev-docs/bench/scripts/**/target/
/dev-docs/bench/scripts/**/__pycache__/
/dev-docs/bench/scripts/**/node_modules/
/dev-docs/bench/scripts/**/*.kgl
/inbox/
# The rules above are root-anchored so `!/dev-docs/bench/scripts/` can re-include
# a subdir — which means a `dev-docs/` created anywhere ELSE is NOT ignored, and
# a packaging step would ship untracked-but-unignored scratch. Only the root
# copy is a working folder; anywhere under a crate is a stray. (codingest put 15
# scratch files into a package that way, caught before publish.)
crates/**/dev-docs/

# Agent worktrees live in ../kglite-visual-worktrees/ — a SIBLING directory of
# this repo, so nothing here needs to ignore them. See CLAUDE.md
# "Agent worktrees".

# macOS
.DS_Store
